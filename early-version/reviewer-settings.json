{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(pytest:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(pnpm test:*)",
      "Bash(yarn test:*)",
      "Bash(cargo test:*)",
      "Bash(go test:*)",
      "Bash(ruff:*)",
      "Bash(eslint:*)",
      "Bash(mypy:*)",
      "Bash(podman compose:*)",
      "Bash(podman compose exec:*)",
      "Bash(curl:*)",
      "Read",
      "Grep",
      "Glob"
    ],
    "ask": [
      "Bash(git push:*)",
      "Edit",
      "Write"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git checkout:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000"
  }
}
